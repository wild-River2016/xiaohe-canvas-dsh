{
  "name": "xiaohe-canvas-dsh",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件 - 小禾画布 AI 创作助手",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "xiaohe-canvas",
    "ai-canvas",
    "mcp"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "author": "xiaohe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wild-River2016/xiaohe-canvas-dsh.git"
  },
  "homepage": "https://github.com/wild-River2016/xiaohe-canvas-dsh#readme"
}
